# Rendered / temporary output
*.rendered.yaml
/tmp/
rendered/

# Local kubeconfigs
kubeconfig
*.kubeconfig
.kube/

# Decrypted secrets — NEVER commit these. Only SealedSecrets belong in Git.
*.secret.yaml
*-secret-plain.yaml
secrets-plain/
*.dec.yaml

# Helm
charts/*.tgz
# Vendored charts: never commit packaged deps or lock files — a committed *.tgz
# (or Chart.lock that triggers `helm dependency build`) shadows the patched
# unpacked subchart directories and reintroduces broken images. See charts/README.md.
charts/**/charts/*.tgz
charts/**/Chart.lock
.helm/

# Editor/OS noise
.DS_Store
*.swp
.idea/
.vscode/
